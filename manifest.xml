<?xml version="1.0" encoding="UTF-8"?>
<!--
    HF Companion - HF band propagation conditions.

    NOTE ON PRODUCT IDS:
    Garmin groups the 47mm and 51mm AMOLED models under shared Connect IQ
    product ids. fenix8pro47mm covers Fenix 8 Pro 47mm and 51mm; fenix847mm
    covers the non-Pro Fenix 8 47mm and 51mm. These IDs are present in SDK 9.2.0.
    Fenix 8 Solar 51mm is a separate 280x280 MIP target (fenix8solar51mm) and
    is intentionally not packaged by this 454x454 AMOLED-focused app.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="HFCompanionApp"
        id="65c0e86b3c1f4ac7b0f8dc10167abf4d"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="3.2.0"
        name="@Strings.AppName"
        type="watch-app">

        <iq:products>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
